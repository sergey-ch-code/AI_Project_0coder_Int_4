# Шаблон переменных окружения (EXAMPLE).
# ------------------------------------------------------------------
# Этот файл — КАРТА настроек проекта: он показывает, КАКИЕ переменные
# нужны, но НЕ содержит реальных значений. Он безопасно лежит в git.
#
# Как пользоваться:
#   1. Скопируйте этот файл в .env            (cp .env.example .env)
#   2. Отредактируйте .env и впишите СВОИ значения.
#   3. Файл .env игнорируется Git (.gitignore) — секреты НЕ уедут в репозиторий.
#
# Правило: сюда НИКОГДА не пишем настоящие пароли/ключи — только
# пустые значения или заглушки-примеры.
# ------------------------------------------------------------------

# --- Приложение ---
APP_NAME="0coder Int"
APP_ENV=development            # development | staging | production
APP_PORT=3000
APP_DEBUG=true

# --- База данных ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=            # реальный пароль — только в .env, здесь пусто

# --- Секреты / токены (примеры-заглушки) ---
# JWT_SECRET=            # сгенерируйте и положите в .env
# API_KEY=               # ключ внешнего сервиса — только в .env

# --- Почта / уведомления (если нужны) ---
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
